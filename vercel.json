{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sottolineature.it"
        }
      ],
      "destination": "https://sottolineature.it/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sottolineature.vercel.app"
        }
      ],
      "destination": "https://sottolineature.it/:path*",
      "permanent": true
    },
    {
      "source": "/citazioni/kazuo-ishiguro-quando-eravamo-orfani/",
      "destination": "/citazioni/kazuo-ishiguro-non-lasciarmi-perche-forse-in/",
      "permanent": true
    },
    {
      "source": "/citazioni/alice-munro-la-vista-da-castle-rock/",
      "destination": "/citazioni/alice-munro-nemico-amico-amante/",
      "permanent": true
    },
    {
      "source": "/citazioni/michela-murgia-accabadora/",
      "destination": "/citazioni/michela-murgia-chiru/",
      "permanent": true
    },
    {
      "source": "/citazioni/fernando-pessoa-il-libro-dell-inquietudine/",
      "destination": "/citazioni/fernando-pessoa-tabacaria/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sottolineature.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.sottolineature.it"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
