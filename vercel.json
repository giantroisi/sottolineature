    {
      "source": "/citazioni/elias-canetti-auto-da-fe/",
      "destination": "/citazioni/elias-canetti-la-provincia-dell-uomo/",
      "permanent": true
    },
    {
      "source": "/citazioni/suzanne-collins-hunger-games/",
      "destination": "/citazioni/suzanne-collins-hunger-games-signore-e-signori/",
      "permanent": true
    },
    {
      "source": "/citazioni/amelie-nothomb-barbablu/",
      "destination": "/citazioni/",
      "permanent": true
    },
    {
      "source": "/autori/amelie-nothomb/",
      "destination": "/autori/",
