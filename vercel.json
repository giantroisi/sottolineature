      "permanent": true
    },
    {
      "source": "/citazioni/naguib-mahfouz-vicolo-del-mortaio/",
      "destination": "/autori/naguib-mahfouz/",
      "permanent": true
    },
    {
      "source": "/citazioni/j-m-barrie-le-avventure-di-peter-pan/",
      "destination": "/citazioni/",
      "permanent": true
    },
    {
      "source": "/autori/j-m-barrie/",
      "destination": "/autori/",
      "permanent": true
    },
    {
      "source": "/citazioni/simone-weil-l-ombra-e-la-grazia/",
